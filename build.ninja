ninja_required_version = 1.5

builddir = build/emscripten
prefix = $builddir/prefix
emcache = $builddir/em-cache

tcl_src = third-party/tcl
tk_src = third-party/tk
tcl_build = $builddir/tcl
tk_build = $builddir/tk
x11_src = third-party/x11.wasm
browser_build = $builddir/browser
browser_manager_focus = $browser_build/manager-focus.o
browser_dist = build/browser
tcl_overlay_unix = $builddir/overlay/tcl/unix
tcl_overlay_unix_stamp = $tcl_overlay_unix/.stamp
tk_overlay_unix = $builddir/overlay/tk/unix
tk_overlay_unix_stamp = $tk_overlay_unix/.stamp
tk_overlay_generic = $builddir/overlay/tk/generic
tk_overlay_generic_stamp = $tk_overlay_generic/.stamp
configure_tools = tools/emscripten-configure-tools

x11wasm_root = $x11_src
x11wasm_builddir = $builddir/x11
x11wasm_emcache = $emcache

include $x11_src/ninja/x11wasm.ninja

x11_lib = $x11wasm_lib

host = wasm32-unknown-emscripten
common_configure = --host=$host --disable-shared --disable-load --disable-threads --disable-rpath --disable-corefoundation tcl_cv_sys_version=Emscripten ac_cv_func_strtoul=yes tcl_cv_strtoul_unbroken=ok
tcl_configure = $common_configure --disable-dll-unloading --with-tzdata=no
tcl_browser_extra_cflags = -DTCL_WIDE_CLICKS=1
tk_configure = $common_configure --without-x --disable-xft --disable-xss

rule overlay_tcl_unix
  command = root=$$(pwd) && overlay="$$root/$tcl_overlay_unix" && rm -rf "$$overlay" && mkdir -p "$$overlay" && for src in "$$root/$tcl_src/unix"/*; do ln -s "$$src" "$$overlay/$${src##*/}"; done && for src in "$$root/browser/tcl/unix"/*; do [ -e "$$src" ] || continue; dst="$$overlay/$${src##*/}" && rm -f "$$dst" && ln -s "$$src" "$$dst"; done && touch "$$root/$tcl_overlay_unix_stamp"
  description = overlay Tcl unix backend
  restat = 1

rule overlay_tk_unix
  command = root=$$(pwd) && overlay="$$root/$tk_overlay_unix" && rm -rf "$$overlay" && mkdir -p "$$overlay" && for src in "$$root/$tk_src/unix"/*; do ln -s "$$src" "$$overlay/$${src##*/}"; done && rm -f "$$overlay/tkUnixFont.c" && cp "$$root/$tk_src/unix/tkUnixFont.c" "$$overlay/tkUnixFont.c" && patch -d "$$overlay" -p0 < "$$root/browser/tk/patches/tkUnixFont.c.patch" && for src in "$$root/browser/tk/unix"/*; do [ -e "$$src" ] || continue; dst="$$overlay/$${src##*/}" && rm -f "$$dst" && ln -s "$$src" "$$dst"; done && ln -sf "$$root/$tk_src/unix/tkUnixEvent.c" "$$overlay/tkUnixEventUpstream.c" && touch "$$root/$tk_overlay_unix_stamp"
  description = overlay Tk unix backend
  restat = 1

rule overlay_tk_generic
  command = root=$$(pwd) && overlay="$$root/$tk_overlay_generic" && rm -rf "$$overlay" && mkdir -p "$$overlay" && for src in "$$root/$tk_src/generic"/*; do ln -s "$$src" "$$overlay/$${src##*/}"; done && for name in tkFont tkTextDisp; do rm -f "$$overlay/$$name.c" && cp "$$root/$tk_src/generic/$$name.c" "$$overlay/$$name.c" && patch -d "$$overlay" -p0 < "$$root/browser/tk/patches/$$name.c.patch" || exit 1; done && for src in "$$root/browser/tk/generic"/*; do [ -e "$$src" ] || continue; dst="$$overlay/$${src##*/}" && rm -f "$$dst" && ln -s "$$src" "$$dst"; done && touch "$$root/$tk_overlay_generic_stamp"
  description = overlay Tk generic browser backend
  restat = 1

rule configure_tcl
  command = root=$$(pwd) && build_triple=$$(cc -dumpmachine 2>/dev/null || echo unknown-unknown-unknown) && mkdir -p "$$root/$tcl_build" "$$root/$prefix" "$$root/$emcache" && cd "$$root/$tcl_build" && PATH="$$root/$configure_tools:$$PATH" EM_CACHE="$$root/$emcache" emconfigure "$$root/$tcl_src/unix/configure" --build="$$build_triple" --prefix="$$root/$prefix" $tcl_configure
  description = configure Tcl

rule build_tcl
  command = root=$$(pwd) && jobs=$$(nproc) && EM_CACHE="$$root/$emcache" emmake make -C "$$root/$tcl_build" UNIX_DIR="$$root/$tcl_overlay_unix" EXTRA_CFLAGS="$tcl_browser_extra_cflags" clean && EM_CACHE="$$root/$emcache" emmake make -C "$$root/$tcl_build" -j"$$jobs" UNIX_DIR="$$root/$tcl_overlay_unix" EXTRA_CFLAGS="$tcl_browser_extra_cflags" libtcl8.6.a && touch "$$root/$tcl_build/.built"
  description = build Tcl

rule configure_tk
  command = root=$$(pwd) && build_triple=$$(cc -dumpmachine 2>/dev/null || echo unknown-unknown-unknown) && mkdir -p "$$root/$tk_build" "$$root/$prefix" "$$root/$emcache" && cd "$$root/$tk_build" && PATH="$$root/$configure_tools:$$PATH" EM_CACHE="$$root/$emcache" emconfigure "$$root/$tk_src/unix/configure" --build="$$build_triple" --prefix="$$root/$prefix" --with-tcl="$$root/$tcl_build" $tk_configure
  description = configure Tk

rule build_tk
  command = root=$$(pwd) && jobs=$$(nproc) && EM_CACHE="$$root/$emcache" emmake make -C "$$root/$tk_build" UNIX_DIR="$$root/$tk_overlay_unix" GENERIC_DIR="$$root/$tk_overlay_generic" X11_INCLUDES="-I$$root/$x11_src/include -I$$root/$tk_src/xlib -DHAVE_XSS=1" clean && EM_CACHE="$$root/$emcache" emmake make -C "$$root/$tk_build" -j"$$jobs" UNIX_DIR="$$root/$tk_overlay_unix" GENERIC_DIR="$$root/$tk_overlay_generic" X11_INCLUDES="-I$$root/$x11_src/include -I$$root/$tk_src/xlib -DHAVE_XSS=1" libtk8.6.a && touch "$$root/$tk_build/.built"
  description = build Tk

rule compile_commands
  command = python3 tools/gen_compile_commands.py --output build/compile_commands.json
  description = generate build/compile_commands.json

rule typecheck_js
  command = mkdir -p build && tsc -p tsconfig.json && touch build/typecheck-js.stamp
  description = typecheck browser JS

rule compile_browser_app
  command = root=$$(pwd) && mkdir -p "$$root/$browser_build" && EM_CACHE="$$root/$emcache" emcc -c -I"$$root/$x11_src/include" -I"$$root/$tcl_build" -I"$$root/$tcl_src/generic" -I"$$root/$tcl_overlay_unix" -I"$$root/$tcl_src/unix" -I"$$root/$tk_build" -I"$$root/$tk_overlay_generic" -I"$$root/$tk_overlay_unix" -I"$$root/$tk_src/unix" -I"$$root/$tk_src/xlib" -DSTATIC_BUILD=1 "$$root/browser/app/main.c" -o "$$root/$browser_build/main.o"
  description = compile browser app

rule link_browser_app
  # Tk selection callbacks can exceed Emscripten's default 4 KiB unwind stack.
  command = root=$$(pwd) && mkdir -p "$$root/$browser_dist" "$$root/$emcache" && EM_CACHE="$$root/$emcache" emcc "$$root/$browser_build/main.o" "$$root/$browser_manager_focus" "$$root/$x11_lib" "$$root/$tk_build/libtk8.6.a" "$$root/$tcl_build/libtcl8.6.a" --js-library "$$root/$x11wasm_js_library" --pre-js "$$root/$x11wasm_js_pre" --shell-file "$$root/browser/app/shell.html" --preload-file "$$root/$tcl_src/library@/lib/tcl8.6" --preload-file "$$root/$tk_src/library@/lib/tk8.6" -sALLOW_MEMORY_GROWTH=1 -sASYNCIFY=1 -sASYNCIFY_STACK_SIZE=8192 -sEXIT_RUNTIME=0 -sERROR_ON_UNDEFINED_SYMBOLS=1 -sEXPORTED_FUNCTIONS=_main,_malloc,_free -o "$$root/$browser_dist/tcltk.html"
  description = link browser app

rule stage_browser_licenses
  command = mkdir -p "$browser_dist/LICENSES/x11.wasm/LICENSES" && cp LICENSE THIRD_PARTY_NOTICES.md "$browser_dist/" && cp LICENSES/*.txt "$browser_dist/LICENSES/" && cp "$x11_src/LICENSE" "$x11_src/THIRD_PARTY_NOTICES.md" "$browser_dist/LICENSES/x11.wasm/" && cp "$x11_src/LICENSES/X11.txt" "$x11_src/LICENSES/Tk.txt" "$x11_src/LICENSES/Lucide.txt" "$browser_dist/LICENSES/x11.wasm/LICENSES/"
  description = collect Tcl/Tk browser licenses

build $browser_dist/LICENSE $
  $browser_dist/THIRD_PARTY_NOTICES.md $
  $browser_dist/LICENSES/Tcl.txt $
  $browser_dist/LICENSES/Tk.txt $
  $browser_dist/LICENSES/Tcl-Tk-extra.txt $
  $browser_dist/LICENSES/LibTomMath.txt $
  $browser_dist/LICENSES/zlib.txt $
  $browser_dist/LICENSES/x11.wasm/LICENSE $
  $browser_dist/LICENSES/x11.wasm/THIRD_PARTY_NOTICES.md $
  $browser_dist/LICENSES/x11.wasm/LICENSES/X11.txt $
  $browser_dist/LICENSES/x11.wasm/LICENSES/Tk.txt $
  $browser_dist/LICENSES/x11.wasm/LICENSES/Lucide.txt: stage_browser_licenses $
  LICENSE THIRD_PARTY_NOTICES.md $
  LICENSES/Tcl.txt LICENSES/Tk.txt LICENSES/Tcl-Tk-extra.txt $
  LICENSES/LibTomMath.txt LICENSES/zlib.txt $
  $x11_src/LICENSE $x11_src/THIRD_PARTY_NOTICES.md $
  $x11_src/LICENSES/X11.txt $x11_src/LICENSES/Tk.txt $x11_src/LICENSES/Lucide.txt

build $tcl_overlay_unix_stamp: overlay_tcl_unix build.ninja browser/tcl/unix/tclUnixTime.c
build $tcl_build/Makefile: configure_tcl build.ninja $configure_tools/uname
build $tcl_build/.built: build_tcl $tcl_build/Makefile $tcl_overlay_unix_stamp

build $tk_overlay_unix_stamp: overlay_tk_unix build.ninja browser/tk/unix/.gitkeep browser/tk/unix/tkUnixPort.h browser/tk/unix/tkBrowserXlibDecls.h browser/tk/unix/tkBrowserInt.h browser/tk/unix/tkBrowserFont.h browser/tk/unix/tkUnixEvent.c browser/tk/unix/tkUnixXId.c browser/tk/patches/tkUnixFont.c.patch third-party/tk/unix/tkUnixEvent.c third-party/tk/unix/tkUnixFont.c
build $tk_overlay_generic_stamp: overlay_tk_generic build.ninja browser/tk/generic/tkWindow.c browser/tk/patches/tkFont.c.patch browser/tk/patches/tkTextDisp.c.patch third-party/tk/generic/tkWindow.c third-party/tk/generic/tkFont.c third-party/tk/generic/tkTextDisp.c
build $tk_build/Makefile: configure_tk $tcl_build/.built build.ninja $configure_tools/uname
build $tk_build/.built: build_tk $tk_build/Makefile $tk_overlay_unix_stamp $tk_overlay_generic_stamp $x11_src/include/X11/Xlib.h $x11_src/include/X11/XlibWasm.h $x11_src/include/X11/Xutil.h $x11_src/include/X11/extensions/scrnsaver.h
build build/compile_commands.json: compile_commands tools/gen_compile_commands.py build.ninja $x11_src/ninja/x11wasm.ninja $tcl_build/Makefile $tk_build/Makefile $tcl_overlay_unix_stamp $tk_overlay_unix_stamp $tk_overlay_generic_stamp
build build/typecheck-js.stamp: typecheck_js tsconfig.json $x11wasm_js_pre $x11wasm_js_library $x11wasm_js_types tests/types/node.d.ts tests/support/tcltk.js tests/tcltk/manager-integration.spec.js
build $browser_build/main.o: compile_browser_app browser/app/main.c build.ninja $tk_overlay_unix_stamp $tk_overlay_generic_stamp
build $browser_manager_focus: x11wasm_compile_c $x11_src/test/browser/manager-focus.c | $x11wasm_xlib_common_deps
build $browser_dist/tcltk.html: link_browser_app $browser_build/main.o $browser_manager_focus $x11_lib $tk_build/.built $tcl_build/.built build/typecheck-js.stamp browser/app/shell.html $x11wasm_js_pre $x11wasm_js_library

build configure-tcl: phony $tcl_build/Makefile
build tcl: phony $tcl_build/.built
build configure-tk: phony $tk_build/Makefile
build tk: phony $tk_build/.built
build x11: phony $x11_lib $x11wasm_js_library $x11wasm_js_pre x11wasm_licenses
build compile_commands: phony build/compile_commands.json
build typecheck_js: phony build/typecheck-js.stamp
build licenses: phony $browser_dist/LICENSE
build browser: phony $browser_dist/tcltk.html licenses
build all: phony tk

default all
