+
+#ifdef TK_WASM_BROWSER
+    /*
+     * Browser canvas text can render UTF-8 runs directly. Keep the run intact
+     * so grapheme clusters and surrogate pairs are not split by X11 subfont
+     * fallback before they reach the DOM backend.
+     */
+    if (numBytes > 0) {
+	int width;
+
+	(void) Tk_MeasureChars(tkfont, source, numBytes, -1, 0, &width);
+	Xutf8DrawString(display, drawable, NULL, gc, x, y, source, numBytes);
+	x += width;
+	if (fontPtr->font.fa.underline != 0) {
+	    XFillRectangle(display, drawable, gc, xStart,
+		    y + fontPtr->underlinePos,
+		    (unsigned) (x - xStart), (unsigned) fontPtr->barHeight);
+	}
+	if (fontPtr->font.fa.overstrike != 0) {
+	    y -= fontPtr->font.fm.descent + (fontPtr->font.fm.ascent) / 10;
+	    XFillRectangle(display, drawable, gc, xStart, y,
+		    (unsigned) (x - xStart), (unsigned) fontPtr->barHeight);
+	}
+	return;
+    }
+#endif
