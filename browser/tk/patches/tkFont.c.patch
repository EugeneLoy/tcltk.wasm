+static int
+BrowserLayoutMeasure(TextLayout *layoutPtr, const char *start, int length,
+    int maxLength, int flags, int *widthPtr)
+{
+    return TkpMeasureCharsInContext(layoutPtr->tkfont, layoutPtr->string,
+	    layoutPtr->numBytes, (int)(start - layoutPtr->string), length,
+	    maxLength, flags, widthPtr);
+}
