{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "third-party/x11.wasm/js/**/*.js",
    "third-party/x11.wasm/js/**/*.d.ts"
  ]
}
